e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u201c<\/strong> \u0441 \u0438\u0437\u043b\u043e\u0436\u0431\u0435\u043d\u0430 \u0435\u043a\u0441\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u201e\u0418\u0437\u043e\u0431\u0440\u0435\u0442\u0435\u043d\u043e \u0432 \u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f\u201c, \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0438\u0440\u0430\u043d\u0438 \u043e\u0442 \u0421\u044a\u044e\u0437\u0430 \u043d\u0430 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0438\u0442\u0435 \u0432 \u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f \u0438 \u0422\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0430\u043b\u043d\u0430\u0442\u0430 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0430 \u041d\u0430\u0443\u0447\u043d\u043e-\u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0442\u0435 \u0441\u044a\u044e\u0437\u0438 \u2013 \u041f\u043b\u043e\u0432\u0434\u0438\u0432. \u0424\u043e\u0440\u0443\u043c\u044a\u0442 \u0441\u044a\u0431\u0440\u0430 \u0438\u0437\u043e\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043b\u0438, \u0443\u0447\u0435\u043d\u0438, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0438 \u0438 \u0443\u0447\u0435\u043d\u0438\u0446\u0438, \u043a\u043e\u0438\u0442\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0445\u0430 \u0441\u0432\u043e\u0438 \u0438\u043d\u043e\u0432\u0430\u0442\u0438\u0432\u043d\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0438 \u043d\u0430\u0443\u0447\u043d\u0438 \u0438\u0434\u0435\u0438.<\/p>\n<p>\u0412 \u0441\u0435\u043a\u0446\u0438\u044f <strong>\u201e\u0418\u043d\u043e\u0432\u0430\u0446\u0438\u0438 \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u0442\u043e\u201c<\/strong> \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201c \u0431\u0435\u0448\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0435\u043d\u0430 \u043e\u0442 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 <strong>\u0418\u0432\u043e \u0416\u0438\u0432\u043a\u043e\u0432 \u041c\u0438\u0442\u0440\u0435\u0432<\/strong> \u043e\u0442 VII \u201e\u0410\u201c \u043a\u043b\u0430\u0441 \u0438 <strong>\u041c\u0438\u0445\u0430\u0438\u043b \u0410\u0441\u043f\u0430\u0440\u0443\u0445\u043e\u0432 \u041c\u0438\u0442\u043e\u0432<\/strong> \u043e\u0442 VIII \u201e\u0410\u201c \u043a\u043b\u0430\u0441 \u043f\u043e\u0434 \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430 <strong>\u0433-\u0436\u0430 \u0412\u0438\u043e\u043b\u0435\u0442\u0430 \u041c\u0430\u0440\u0438\u043d\u043e\u0432\u0430<\/strong>.<\/p>\n<p>\u0422\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0445\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u201eBlinkGate\u201c \u2013 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430 \u043f\u043e\u0434\u043f\u043e\u043c\u0430\u0433\u0430\u043d\u0435 \u043d\u0430 \u0445\u043e\u0440\u0430 \u0441 \u043f\u044a\u043b\u043d\u0430 \u043f\u0430\u0440\u0430\u043b\u0438\u0437\u0430, \u043a\u043e\u044f\u0442\u043e \u0438\u043c \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u0434\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0438\u0440\u0430\u0442 \u0447\u0440\u0435\u0437 \u043c\u0438\u0433\u0430\u043d\u0435 \u0441 \u043e\u0447\u0438. \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430\u0442\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u043c\u043e\u0440\u0437\u043e\u0432 \u043a\u043e\u0434, \u043a\u0430\u0442\u043e \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u043c\u0438\u0433\u0430\u043d\u0438\u044f\u0442\u0430 \u0438 \u044f \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0432\u0430 \u0432 \u0442\u0435\u043a\u0441\u0442. \u041f\u043e \u0442\u043e\u0437\u0438 \u043d\u0430\u0447\u0438\u043d \u0445\u043e\u0440\u0430, \u043a\u043e\u0438\u0442\u043e \u043d\u0435 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u0438\u043b\u0438 \u0434\u0430 \u0438\u0437\u0432\u044a\u0440\u0448\u0432\u0430\u0442 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f, \u043f\u043e\u043b\u0443\u0447\u0430\u0432\u0430\u0442 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0437\u0430 \u043f\u043e-\u043b\u0435\u0441\u043d\u0430 \u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u044f \u0441\u044a\u0441 \u0441\u0432\u043e\u0438\u0442\u0435 \u0431\u043b\u0438\u0437\u043a\u0438 \u0438 \u0441 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0442\u0435 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0438.<\/p>\n<p>\u041f\u0440\u043e\u0435\u043a\u0442\u044a\u0442 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u0446\u0438\u0442\u0435 \u0438 \u0433\u043e\u0441\u0442\u0438\u0442\u0435 \u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f\u0442\u0430 \u0441\u044a\u0441 \u0441\u0432\u043e\u044f\u0442\u0430 \u0441\u043e\u0446\u0438\u0430\u043b\u043d\u0430 \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0441\u0442 \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u043c\u043e\u0441\u0442. \u201eBlinkGate\u201c \u0435 \u043f\u0440\u0438\u043c\u0435\u0440 \u0437\u0430 \u0442\u043e\u0432\u0430 \u043a\u0430\u043a \u0437\u043d\u0430\u043d\u0438\u044f\u0442\u0430 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438, \u043f\u0440\u043e\u0433\u0440\u04