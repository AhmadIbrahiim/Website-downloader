43e\u0440\u043c\u0438\u0440\u0430\u043d\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0438 \u0437\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043a\u0430\u0437\u0443\u0441\u0438 \u043e\u0442 \u0440\u0435\u0430\u043b\u043d\u0438\u044f \u0436\u0438\u0432\u043e\u0442. \u0423\u0447\u0435\u0431\u043d\u0438\u044f\u0442 \u043f\u043b\u0430\u043d \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430 \u043e\u0431\u0449\u043e\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u043d\u0430 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430, \u043d\u043e \u0430\u043a\u0446\u0435\u043d\u0442 \u0432 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u0442\u043e \u0441\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u0438\u0440\u0430\u0449\u0430\u0442\u0430 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u0418\u0422, \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430, \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0438 \u043d\u0430\u0443\u043a\u0438. <br \/>\u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u0442\u043e \u043f\u043e <strong>\u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438 \u0438 \u043f\u043e \u043d\u0435\u043c\u0441\u043a\u0438 \u0435\u0437\u0438\u043a<\/strong> \u0432 \u043f\u044a\u0440\u0432\u0438 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0430\u043b\u0435\u043d \u0435\u0442\u0430\u043f \u043d\u0430 \u0441\u0440\u0435\u0434\u043d\u0430\u0442\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u043d\u0430 \u0441\u0442\u0435\u043f\u0435\u043d \u0435 \u043d\u0430\u0441\u043e\u0447\u0435\u043d\u043e \u043a\u044a\u043c \u043e\u0432\u043b\u0430\u0434\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u0438 \u0437\u043d\u0430\u043d\u0438\u044f, \u0443\u043c\u0435\u043d\u0438\u044f \u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f, \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u0438 \u0441 \u0438\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0442\u0438\u0432\u043d\u0438 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u043a\u0430 \u0438 \u0441 \u043e\u0431\u0449\u0443\u0432\u0430\u043d\u0435\u0442\u043e. \u0412 V\u0406\u0406\u0406 \u043a\u043b\u0430\u0441 \u0441 \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0432\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u0441\u0435 \u043f\u043e\u043a\u0440\u0438\u0432\u0430\u0442 <strong>\u043d\u0438\u0432\u0430 A1, A2 \u0438 B1.1<\/strong>. \u0412 \u043a\u0440\u0430\u044f \u043d\u0430 \u0425 \u043a\u043b\u0430\u0441 \u0441\u0435 \u043e\u0447\u0430\u043a\u0432\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0434\u0430 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0430\u0442 <strong>\u043d\u0438\u0432\u043e \u04121 <\/strong>\u043f\u043e \u041e\u0431\u0449\u0430\u0442\u0430 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0430 \u0435\u0437\u0438\u043a\u043e\u0432\u0430 \u0440\u0430\u043c\u043a\u0430. \u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430\u0442\u0430 \u043f\u043e <strong>\u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u0437\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u043e\u0442 \u0425\u0406 \u0438 \u0425\u0406\u0406 \u043a\u043b\u0430\u0441<\/strong>, \u0441\u043b\u0435\u0434 \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0432\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0435\u0437\u0438\u043a\u0430 \u0432 V\u0406\u0406\u0406 \u043a\u043b\u0430\u0441, \u0435 \u0434\u0430 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0430\u0442 <strong>\u043d\u0438\u0432\u043e \u04122.1<\/strong> \u043f\u043e \u041e\u0431\u0449\u0430\u0442\u0430 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0430 \u0435\u0437\u0438\u043a\u043e\u0432\u0430 \u0440\u0430\u043c\u043a\u0430 \u0432 \u043a\u0440\u0430\u044f \u043d\u0430 \u0425\u0406\u0406 \u043a\u043b\u0430\u0441. \u041d\u0438\u0432\u043e\u0442\u043e \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u043f\u043e <strong>\u043d\u0435\u043c\u0441\u043a\u0438 \u0435\u0437\u0438\u043a<\/strong> \u0441\u043b\u0435\u0434 \u0437\u0430\u0432\u044a\u0440\u0448\u0435\u043d V\u0406\u0406\u0406 \u043a\u043b\u0430\u0441 \u0435 <strong>\u04102<\/strong>. \u0412 \u043a\u0440\u0430\u044f \u043d\u0430 \u0425 \u043a\u043b\u0430\u0441 \u043f\u043e \u043d\u0435\u043c\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u0441\u0435 \u043e\u0447\u0430\u043a\u0432\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0434\u0430 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0430\u0442 \u0440\u0430\u0432\u043d\u0438\u0449\u0435 <strong>\u04121<\/strong> \u043f\u043e \u041e\u0431\u0449\u0430\u0442\u0430 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0430 \u0435\u0437\u0438\u043a\u043e\u0432\u0430 \u0440\u0430\u043c\u043a\u0430, \u0430 \u0432 \u043a\u0440\u0430\u044f \u043d\u0430 \u0425\u0406\u0406 \u043a\u043b\u0430\u0441 \u2013 <strong>\u04122<\/strong>. \u0412 IX \u043a\u043b\u0430\u0441 \u0441\u0435 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0437\u0430 \u0438\u0437\u0443\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 <strong>\u0432\u0442\u043e\u0440\u0438 \u0447\u0443\u0436\u0434 \u0435\u0437\u0438\u043a \u2013 \u0440\u0443\u0441\u043a\u0438 \u0438\u043b\u0438 \u0444\u0440\u0435\u043d\u0441\u043a\u0438<\/strong>. \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0442\u0435 \u0438 \u043b\u0438\u043d\u0433\u0432\u0438\u0441\u0442\u0438\u0447\u043d\u0438\u0442\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0441\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442 \u043d\u0430 \u043d\u0438\u0432\u043e, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430\u0449\u043e \u0441\u0438\u0433\u0443\u0440\u043d\u0430 \u0441\u043b\u0435\u0434\u0432\u0430\u0449\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f. <br \/><br \/><strong>\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \/ \u041f\u0440\u043e\u0444\u0435\u0441\u0438\u0438<\/strong><br \/><strong>\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u044f \u201e\u0421\u0438\u0441\u0442\u0435\u043c\u0435\u043d \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0441\u0442\u201c, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e\u0441\u0442 \u201e\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435\u201c<\/strong> \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d\u0438\u044f\u0442 \u0443\u0447\u0435\u0431\u0435\u043d \u043f\u043b\u0430\u043d \u0437\u0430 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e\u0441\u0442\u0442\u0430 \u201e\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435\u201c \u0434\u0430\u0432\u0430 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0434\u0430 \u0438\u0437\u0443\u0447\u0430\u0432\u0430\u0442 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438 \u043a\u0430\u0442\u043e \u043e\u0431\u0435\u043a\u0442\u043d\u043e-\u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u0430\u043d\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u0430 \u0441\u043e\u0444\u0442\u0443\u0435\u0440, \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435, \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435 \u0437\u0430 \u0432\u0433\u0440\u0430\u0434\u0435\u043d\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0438 \u0434\u0440. \u0423 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0441\u0435 \u0440\u0430\u0437\u0432\u0438\u0432\u0430 \u0438 \u0438\u0437\u0433\u0440\u0430\u0436\u0434\u0430 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438\u0447\u043d\u043e, \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e, \u0430\u0431\u0441\u0442\u0440\u0430\u043a\u0442\u043d\u043e \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e \u043c\u0438\u0441\u043b\u0435\u043d\u0435. \u0423\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u043e\u0432\u043b\u0430\u0434\u044f\u0432\u0430\u0442 \u043d\u0430\u0439-\u0442\u044a\u0440\u0441\u0435\u043d\u0438\u0442\u0435 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438 \u0435\u0437\u0438\u0446\u0438 \u0437\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435, \u0441\u043e\u0444\u0442\u0443\u0435\u0440\u043d\u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u043d\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u0438. \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0442\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043d\u0438\u044f, \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0438 \u0438 \u0442\u044f\u0441\u043d\u0430\u0442\u0430 \u0432\u0440\u044a\u0437\u043a\u0430 \u0441 \u0418\u0422 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0438\u043c\u0430\u0442 \u043e\u0433\u0440\u043e\u043c\u043d\u0438 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0430\u0442\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0438 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0441\u043e\u0444\u0442\u0443\u0435\u0440\u043d\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0438, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u0430 \u0443\u0435\u0431 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u0430 \u043c\u043e\u0431\u0438\u043b\u043d\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u0430 \u0432\u0433\u0440\u0430\u0434\u0435\u043d\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0434\u0440. <strong>\u0412 \u043a\u0440\u0430\u044f \u043d\u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u0442\u043e \u0441\u0438 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u043f\u0440\u0438\u0434\u043e\u0431\u0438\u0432\u0430\u0442 III \u0441\u0442\u0435\u043f\u0435\u043d \u043d\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f.<\/strong> <br \/><br \/><strong>\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u044f \u201e\u041a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u0435\u043d \u0433\u0440\u0430\u0444\u0438\u043a\u201c, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e\u0441\u0442 \u201e\u041a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u043d\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0430\u201c<\/strong><br \/>\u0421\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d\u0438\u044f\u0442 \u0443\u0447\u0435\u0431\u0435\u043d \u043f\u043b\u0430\u043d \u0437\u0430 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e\u0441\u0442\u0442\u0430 \u201e\u041a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u043d\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0430\u201c \u0434\u0430\u0432\u0430 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0434\u0430 \u0438\u0437\u0443\u0447\u0430\u0432\u0430\u0442 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438 \u043a\u0430\u0442\u043e \u0436\u0438\u0432\u043e\u043f\u0438\u0441, \u0434\u0438\u0437\u0430\u0439\u043d \u043d\u0430 \u043f\u0435\u0447\u0430\u0442\u043d\u0438 \u0438\u0437\u0434\u0430\u043d\u0438\u044f, \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u043d \u0434\u0438\u0437\u0430\u0439\u043d \u0438 \u0440\u0435\u043a\u043b\u0430\u043c\u0430, \u0432\u0438\u0437\u0443\u0430\u043b\u043d\u0438 \u0438\u0437\u043a\u0443\u0441\u0442\u0432\u0430 \u0438 \u0434\u0440. \u0423\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u043f\u0440\u0438\u0434\u043e\u0431\u0438\u0432\u0430\u0442 \u0437\u0430\u0434\u044a\u043b\u0431\u043e\u0447\u0435\u043d\u0438 \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f, \u043a\u043e\u0438\u0442\u043e \u0441\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0437\u0430 \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0442\u043e \u0438\u043c \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435. \u041e\u0432\u043b\u0430\u0434\u044f\u0432\u0430\u0442 \u0430\u043a\u0442\u0443\u0430\u043b\u043d\u0438\u0442\u0435 \u043a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u043d\u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u0441\u0435 \u0438\u0437\u044f\u0432\u044f\u0442 \u0432 \u0441\u0444\u0435\u0440\u0