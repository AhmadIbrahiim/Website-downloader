0\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0432\u0438\u0437\u0443\u0430\u043b\u043d\u0438 \u0438\u0437\u043a\u0443\u0441\u0442\u0432\u0430 \u201e\u0410\u0437 \u043c\u043e\u0433\u0430 \u0442\u0443\u043a \u0438 \u0441\u0435\u0433\u0430\u201c, \u0432 \u043a\u043e\u0435\u0442\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u0430\u0445\u0430 600 \u0443\u0447\u0435\u043d\u0438\u0446\u0438 \u043e\u0442 \u0446\u044f\u043b\u0430\u0442\u0430 \u0441\u0442\u0440\u0430\u043d\u0430, \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438 \u0432 10 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438.<\/p>\n<p>\u0421 \u0433\u043e\u0440\u0434\u043e\u0441\u0442 \u0441\u043f\u043e\u0434\u0435\u043b\u044f\u043c\u0435 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0438\u0442\u0435 \u043d\u0430 \u043d\u0430\u0448\u0438\u0442\u0435 \u0443\u0447\u0435\u043d\u0438\u0446\u0438, \u043a\u043e\u0438\u0442\u043e \u0441\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0445\u0430 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u043e \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0445\u0430 \u0437\u0430\u0432\u0438\u0434\u043d\u0438 \u0437\u043d\u0430\u043d\u0438\u044f, \u0443\u043f\u043e\u0440\u0438\u0442\u043e\u0441\u0442 \u0438 \u0441\u044a\u0441\u0442\u0435\u0437\u0430\u0442\u0435\u043b\u0435\u043d \u0434\u0443\u0445.<\/p>\n<p>\u041d\u0438\u043a\u043e\u043b\u0430 \u0410\u043d\u0434\u0440\u0435\u0435\u0432 \u043e\u0442 XI \u043a\u043b\u0430\u0441 \u0437\u0430\u0432\u043e\u044e\u0432\u0430 I \u043c\u044f\u0441\u0442\u043e \u0432 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u201e\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435\u201c, \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0430\u0439\u043a\u0438 \u043e\u0442\u043b\u0438\u0447\u043d\u0438 \u0437\u043d\u0430\u043d\u0438\u044f, \u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e \u043c\u0438\u0441\u043b\u0435\u043d\u0435 \u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u043e\u0441\u0442.<\/p>\n<p>\u041f\u043b\u0430\u043c\u0435\u043d\u0430 \u0418\u0432\u0430\u043d\u043e\u0432\u0430 \u043e\u0442 XI \u043a\u043b\u0430\u0441 \u0435 \u043d\u0430 IV \u043c\u044f\u0441\u0442\u043e \u0432 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u201e\u041a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f \u0438 \u0434\u0438\u0437\u0430\u0439\u043d \u043d\u0430 \u0432\u0438\u0434\u0435\u043e\u0438\u0433\u0440\u0438\u201c. \u041f\u0440\u043e\u0435\u043a\u0442\u044a\u0442 \u043d\u0430 \u0435\u043a\u0438\u043f\u0430, \u0432 \u043a\u043e\u0439\u0442\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u0430 \u0443\u0447\u0435\u043d\u0438\u0447\u043a\u0430\u0442\u0430, \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0438 \u0436\u0443\u0440\u0438\u0442\u043e \u0441\u044a\u0441 \u0441\u0432\u043e\u044f\u0442\u0430 \u043a\u0440\u0435\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442, \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u043d\u0430 \u0438\u0434\u0435\u044f \u0438 \u0434\u043e\u0431\u0440\u0435 \u043e\u0431\u043c\u0438\u0441\u043b\u0435\u043d\u0430 \u0438\u0433\u0440\u043e\u0432\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430.<\/p>\n<p>\u0421 \u0440\u0435\u0448\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 \u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0437\u0430 \u0443\u0441\u043f\u0435\u0445 \u0432 \u0441\u044a\u0441\u0442\u0435\u0437\u0430\u043d\u0438\u0435\u0442\u043e \u0441\u0435 \u0432\u043a\u043b\u044e\u0447\u0438\u0445\u0430 \u0410\u043d\u0442\u043e\u043d\u0438\u043e \u0421\u0438\u043c\u0435\u043e\u043d\u043e\u0432, \u0410\u043b\u0435\u043a\u0441 \u041a\u044a\u0440\u043c\u0430\u0434\u0436\u044a, \u0415\u0440\u0435\u043d \u0420\u0430\u0438\u0444\u043e\u0432 \u0438 \u0410\u043b\u0435\u043a\u0437\u0430\u043d\u0434\u044a\u0440\u00a0 \u0424\u0430\u0439\u043d \u043e\u0442 IX \u043a\u043b\u0430\u0441.<\/p>\n<p>\u0420\u044a\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b \u043d\u0430 \u043e\u0442\u0431\u043e\u0440\u0430, \u0443\u0447\u0430\u0441\u0442\u0432