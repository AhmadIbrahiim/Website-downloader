9. \u0412 \u0441\u0432\u043e\u044f\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0438\u043c\u0430 \u043d\u0430\u0434 500 \u043c\u0435\u0434\u0430\u043b\u0438\u0441\u0442\u0438 \u043e\u0442 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0444\u043e\u0440\u0443\u043c\u0438, \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u043a\u043e\u0438\u0442\u043e \u0435 \u0438\u0437\u0440\u0430\u0437\u0435\u043d\u0430 \u0447\u0440\u0435\u0437 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0430\u0442\u0430 \u201e\u0421\u0442\u0435\u043d\u0430 \u043d\u0430 \u0441\u043b\u0430\u0432\u0430\u0442\u0430\u201d.<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u0412\u0441\u0438\u0447\u043a\u0438 \u0442\u0435\u0437\u0438 \u0443\u0441\u043f\u0435\u0445\u0438 \u0443\u0442\u0432\u044a\u0440\u0436\u0434\u0430\u0432\u0430\u0442 \u041e\u041c\u0413 \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201d \u043a\u0430\u0442\u043e \u0435\u0434\u043d\u043e \u043e\u0442 \u043d\u0430\u0439-\u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u0438\u0442\u0435 \u0438 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u043d\u0438 \u0443\u0447\u0435\u0431\u043d\u0438 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430, \u0433\u043e\u043b\u044f\u043c\u0430 \u0447\u0430\u0441\u0442 \u043e\u0442 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438\u0442\u0435 \u043d\u0430 \u043a\u043e\u0435\u0442\u043e \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442 \u043a\u044a\u043c \u0438\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u043d\u0438\u044f \u0435\u043b\u0438\u0442, \u0438\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u0449 \u043e\u0431\u043b\u0438\u043a\u0430 \u043d\u0430 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u0430 \u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f.<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u0413\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0441 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0438\u0442\u0435 \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u0442\u043e \u0438 \u0441 \u043f\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0442\u0430 \u0441\u0438, \u0430 \u0438\u043c\u0435\u043d\u043d\u043e 65 \u043c\u0435\u0434\u0430\u043b\u0438\u0441\u0442\u0438 \u043e\u0442 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0444\u043e\u0440\u0443\u043c\u0438, \u043e\u043f\u0438\u0441\u0430\u043d\u0438 \u0432 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0430\u0442\u0430 \u201c\u0421\u0442\u0435\u043d\u0430 \u043d\u0430 \u0441\u043b\u0430\u0432\u0430\u0442\u0430\u201d.<\/p>\r\n<\/div>\r\n<\/div>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\"><strong>\u041e\u0442 2003 \u0432 \u041c\u0413 \u0441\u0430 \u0432\u044a\u0432\u0435\u0434\u0435\u043d\u0438 \u0443\u043d\u0438\u0444\u043e\u0440\u043c\u0438 \u0437\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435.<\/strong><\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0442\u0435 \u043f\u0430\u0440\u0430\u043b\u0435\u043b\u043a\u0438 \u0441\u0430 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0438 \u043f\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430 \u0424\u0410\u0420 \u043f\u0440\u0435\u0437 1997 \u0433\u043e\u0434\u0438\u043d\u0430. \u041a\u043e\u043b\u0435\u043a\u0442\u0438\u0432\u044a\u0442 \u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0430\u043b \u0432 \u0441\u044a\u0437\u0434\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0443\u0447\u0435\u0431\u043d\u0438\u044f \u043f\u043b\u0430\u043d \u043d\u0430 \u0442\u0430\u0437\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u044f.<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u0412\u0441\u044f\u043a\u0430 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u0442 &#8222;\u0414\u0435\u043d \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0442\u043e \u0441\u0430\u043c\u043e\u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u0442\u043e&#8220;, &#8222;\u0414\u0435\u043d \u043d\u0430 \u0442\u0430\u043b\u0430\u043d\u0442\u0430&#8220;, \u0441\u043f\u043e\u0440\u0442\u0435\u043d \u043f\u0440\u0430\u0437\u043d\u0438\u043a, \u041a\u043e\u043d\u043a\u0443\u0440\u0441 \u0437\u0430 \u043d\u0430\u0439-\u0445\u0443\u0431\u0430\u0432\u0430 \u0441\u0442\u0430\u044f &#8211; &#8222;\u0423\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e &#8211; \u043c\u043e\u0439 \u0432\u0442\u043e\u0440\u0438 \u0434\u043e\u043c&#8220; , \u0430 \u0441\u044a\u0449\u043e \u0438 \u0444\u0443\u0442\u0431\u043e\u043b\u0435\u043d \u0442\u0443\u0440\u043d\u0438\u0440. \u041c\u0413 \u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440 \u043d\u0430 \u0434\u0432\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u043d\u0438 \u0442\u0443\u0440\u043d\u0438\u0440\u0430 &#8211; \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0442\u0443\u0440\u043d\u0438\u0440\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 &#8222;\u0414\u0438\u043c\u043e \u041c\u0430\u043b\u0435\u0448\u043a\u043e\u0432&#8220; \u0438 \u0420\u0443\u043c\u0435\u043d \u0413\u0440\u043e\u0437\u0434\u0430\u043d\u043e\u0432&#8220; .<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\"><strong>\u0414\u0418\u041c\u041e \u041c\u0410\u041b\u0415\u0428\u041a\u041e\u0412 &#8211; \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u043d\u0430 \u041e\u041c\u0413 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 1971 &#8211; 1975 \u0433.<\/strong><\/p>\r\n\r\n\r\n\r\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\r\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis: 66.66%;\">\r\n<p class=\"wp-block-paragraph\">\u201e\u041e\u0442 \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u0442\u0430 \u043d\u0430 \u0432\u0440\u0435\u043c\u0435\u0442\u043e, \u043a\u043e\u0433\u0430\u0442\u043e \u0441\u0438 \u043c\u0438\u0441\u043b\u044f \u0437\u0430 \u043d\u0430\u0447\u0430\u043b\u043e\u0442\u043e, \u0438\u0441\u043a\u0430\u043c \u0441\u044a\u0440\u0434\u0435\u0447\u043d\u043e \u0434\u0430 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043d\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u043a\u043e\u043b\u0435\u0433\u0438, \u0441 \u043a\u043e\u0438\u0442\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0445\u043c\u0435 \u043e\u0441\u043d\u043e\u0432\u0438\u0442\u0435 \u043d\u0430 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u0442\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f \u0438 \u0438\u0437\u0431\u0440\u0430\u0445\u043c\u0435 \u043d\u0435\u0438\u043d \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u0435\u043d \u043f\u0430\u0442\u0440\u043e\u043d.<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u041d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u0438\u0445\u043c\u0435 \u0437\u0430\u0434\u0440\u0443\u0436\u043d\u043e \u0438 \u0437\u0430\u0435\u0434\u043d\u043e. \u0412\u0441\u0438\u0447\u043a\u0438 \u2013 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0446\u0438, \u0444\u0438\u043b\u043e\u043b\u043e\u0437\u0438, \u0438\u0441\u0442\u043e\u0440\u0438\u0446\u0438, \u0431\u0438\u043e\u043b\u043e\u0437\u0438, \u0444\u0438\u0437\u0438\u0446\u0438, \u0445\u0438\u043c\u0438\u0446\u0438, \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438, \u0443\u0447\u0438\u0442\u0435\u043b\u0438 \u043f\u043e \u043c\u0443\u0437\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0435.<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u0418\u0441\u043a\u0430\u043c \u0434\u0430 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0438 \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435, \u043d\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438 \u043d\u0430 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e. \u0421 \u0440\u0430\u0434\u043e\u0441\u0442 \u043e\u0442\u043a\u0440\u0438\u0432\u0430\u043c, \u0447\u0435 \u0442\u0435 \u0441\u0430 \u043d\u0430\u043c\u0435\u0440\u0438\u043b\u0438 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u043e \u043c\u044f\u0441\u0442\u043e \u0432 \u043d\u0430\u0448\u0435\u0442\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e. \u041d\u043e \u043f\u0440\u0438\u0432\u044a\u0440\u0437\u0430\u043d\u043e\u0441\u0442\u0442\u0430 \u043a\u044a\u043c \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u0442\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f \u0433\u0438 \u043d\u0430\u043a\u0430\u0440\u0430 \u0434\u0430 \u0441\u044a\u0437\u0434\u0430\u0434\u0430\u0442 \u0441\u0432\u043e\u0439 \u043a\u043b\u0443\u0431 \u201e\u041f\u0438\u0442\u0430\u0433\u043e\u0440 \u2013 \u043f\u0440\u0438\u044f\u0442\u0435\u043b\u0438 \u043d\u0430 \u041e\u041c\u0413\u201c, \u0434\u0430 \u0438\u0437\u0433\u0440\u0430\u0434\u044f\u0442 \u0441\u0432\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e, \u0432 \u043a\u043e\u0435\u0442\u043e \u0434\u0430 \u0433\u0438 \u043e\u0431\u0435\u0434\u0438\u043d\u044f\u0432\u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u0442\u0435\u043b\u043d\u043e\u0441\u0442\u0442\u0430 \u043a\u044a\u043c \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0438 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u0442\u0430, \u0447\u0435 \u0441\u0430 \u043d\u0430\u0448\u0438 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438.<\/p>\r\n\r\n\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u041d\u0430\u043a\u0440\u0430\u044f \u043a\u0430\u043a\u0432\u043e \u0434\u0430 \u043f\u043e\u0436\u0435\u043b\u0430\u044f \u043d\u0430 \u0443\u0447\u0438\u0442\u0435\u043b\u0438, \u0443\u0447\u0435\u043d\u0438\u0446\u0438 \u0438 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438?<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u041d\u0430 \u043c\u043e\u044f\u0442\u0430 \u0432\u044a\u0437\u0440\u0430\u0441\u0442 \u0438\u0437\u0432\u0435\u0436\u0434\u0430\u043c \u043d\u0430 \u043f\u0440\u0435\u0434\u0435\u043d \u043f\u043b\u0430\u043d \u0437\u0434\u0440\u0430\u0432\u0435, \u0437\u0434\u0440\u0430\u0432\u0435 \u0438 \u043f\u0430\u043a \u0437\u0434\u0440\u0430\u0432\u0435.<\/p>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">\u0418\u043c\u0430 \u043b\u0438 \u0433\u043e, \u043a\u0430\u0437\u0432\u0430\u0442, \u0438 \u0443\u0441\u043f\u0435\u0445\u0438\u0442\u0435 \u0438\u0434\u0432\u0430\u0442, \u0438\u0434\u0432\u0430 \u0438 \u0449\u0430\u0441\u0442\u0438\u0435\u0442\u043e.\u201c<\/p>\r\n\r\n\r\n\r\n<div class=\"wp-block-spacer\" style=\"height: 100px;\" aria-hidden=\"true\">\u00a0<\/div>\r\n\r\n\r\n\r\n<blockquote class=\"wp-block-quote is-layout-flow wp-block-quote-is-layout-flow\">\r\n<p class=\"wp-block-paragraph\">\u041b\u042e\u0411\u041e\u0412\u0422\u0410 \u041a\u042a\u041c \u0427\u0418\u0421\u041b\u041e\u0422\u041e \u03c0\u2026 \u0421\u041b\u0415\u0414 40 \u0413\u041e\u0414\u0418\u041d\u0418 &#8211; \u0435\u0434\u043d\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f, \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0430 \u043e\u0442 XI \u0433 \u043a\u043b\u0430\u0441, \u0432\u0438\u043f\u0443\u0441\u043a 1976 \u0433\u043e\u0434\u0438\u043d\u0430.<\/p>\r\n<\/blockquote>\r\n\r\n\r\n\r\n<p class=\"wp-block-paragraph\">&nbsp;<\/p>\r\n<\/div>\r\n\r\n\r\n\r\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis: 33.33%;\">\r\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" class=\"wp-image-6552\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/dimo_maleshkov.png\" alt=\"\" width=\"270\" height=\"333\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/dimo_maleshkov.png 216w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/dimo_maleshkov-10x12.png 10w\" sizes=\"(max-width: 270px) 100vw, 270px\" \/><\/figure>\r\n\r\n\r\n\r\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" class=\"wp-image-6554\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/maleshkov_aranasov.png\" alt=\"\" width=\"268\" height=\"286\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/maleshkov_aranasov.png 270w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/maleshkov_aranasov-11x12.png 11w\" sizes=\"(max-width: 268px) 100vw, 268px\" \/><\/figure>\r\n<\/div>\r\n<\/div>\r\n<!-- \/wp:columns --><!-- wp:post-content --><!-- wp:columns {\"verticalAlignment\":\"center\"} -->\r\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"66.66%\"} -->\r\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis: 66.66%;\"><!-- wp:image {\"align\":\"right\",\"id\":6501,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\r\n<figure class=\"wp-block-image alignright size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"604\" height=\"338\" class=\"wp-image-6501\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/omg_24mai_2013.jpg\" alt=\"\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/omg_24mai_2013.jpg 604w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/omg_24mai_2013-300x168.jpg 300w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/omg_24mai_2013-18x10.jpg 18w\" sizes=\"(max-width: 604px) 100vw, 604px\" \/><\/figure>\r\n<!-- \/wp:image --><\/div>\r\n<!-- \/wp:column -->\r\n\r\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"33.33%\"} -->\r\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis: 33.33%;\"><!-- wp:paragraph -->\r\n<p><strong>\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201d-<\/strong>\u00a0\u041f\u043b\u043e\u0432\u0434\u0438\u0432\u00a0<strong>\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043f\u0440\u0435\u0437 1971<\/strong>\u00a0\u0433. \u0441 \u043f\u0440\u0438\u0435\u043c \u043e\u0442 \u0434\u0432\u0430 \u0432\u0438\u043f\u0443\u0441\u043a\u0430 \u0441 \u043f\u0440\u043e\u0444\u0438\u043b\u0438\u0442\u0435 \u201e\u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u201d \u0438 \u201e\u0418\u0437\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u201d.<\/p>\r\n<!-- \/wp:paragraph --><\/div>\r\n<!-- \/wp:column --><\/div>\r\n<!-- \/wp:columns -->\r\n\r\n<!-- wp:columns {\"verticalAlignment\":\"center\"} -->\r\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\r\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"align\":\"right\"} -->\r\n<p class=\"has-text-align-right\">\u041f\u044a\u0440\u0432\u0438\u044f\u0442 \u045d\u00a0<strong>\u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u0435 \u0414\u0438\u043c\u043e \u041c\u0430\u043b\u0435\u0448\u043a\u043e\u0432<\/strong>, \u043a\u043e\u0439\u0442\u043e \u0441 \u043a\u043e\u043b\u0435\u043a\u0442\u0438\u0432 \u043e\u0442 21 \u0443\u0447\u0438\u0442\u0435\u043b\u0438 \u043f\u043e\u043b\u0430\u0433\u0430 \u043e\u0441\u043d\u043e\u0432\u0438\u0442\u0435 \u043d\u0430 \u0435\u0434\u043d\u043e \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0443\u0447\u0435\u0431\u043d\u043e \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0435. \u0417\u0430 \u043f\u0430\u0442\u0440\u043e\u043d \u043d\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0435 \u0438\u0437\u0431\u0440\u0430\u043d\u043e \u0438\u043c\u0435\u0442\u043e \u043d\u0430 \u0430\u043a\u0430\u0434\u0435\u043c\u0438\u043a \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:image {\"align\":\"center\",\"id\":6500,\"width\":141,\"height\":143,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\r\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" class=\"wp-image-6500\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history2.bmp\" alt=\"\" width=\"141\" height=\"143\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history2.bmp 206w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history2-12x12.jpg 12w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history2-70x70.jpg 70w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history2-100x100.jpg 100w\" sizes=\"(max-width: 141px) 100vw, 141px\" \/><\/figure>\r\n<!-- \/wp:image -->\r\n\r\n<!-- wp:paragraph {\"align\":\"right\"} -->\r\n<p class=\"has-text-align-right\">\u041e\u0449\u0435 \u043f\u0440\u0435\u0437 \u043f\u044a\u0440\u0432\u0438\u0442\u0435 \u0443\u0447\u0435\u0431\u043d\u0438 \u0433\u043e\u0434\u0438\u043d\u0438 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438\u0442\u0435 \u043d\u0430 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u0441\u0435 \u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442 \u0432 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0444\u043e\u0440\u0443\u043c\u0438 \u0438 \u043f\u0435\u0447\u0435\u043b\u044f\u0442 \u043f\u0440\u0438\u0437\u043e\u0432\u0438 \u043c\u0435\u0441\u0442\u0430.<\/p>\r\n<!-- \/wp:paragraph --><\/div>\r\n<!-- \/wp:column -->\r\n\r\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\r\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"align\":\"right\",\"id\":6507,\"width\":503,\"height\":326,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\r\n<figure class=\"wp-block-image alignright size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" class=\"wp-image-6507\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history1.jpg\" alt=\"\" width=\"503\" height=\"326\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history1.jpg 604w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history1-300x195.jpg 300w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history1-18x12.jpg 18w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history1-370x240.jpg 370w\" sizes=\"(max-width: 503px) 100vw, 503px\" \/><\/figure>\r\n<!-- \/wp:image --><\/div>\r\n<!-- \/wp:column --><\/div>\r\n<!-- \/wp:columns -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 \u0443\u0447\u0435\u0431\u043d\u0430\u0442\u0430\u00a0<strong>1975\/76<\/strong>\u00a0\u0433\u043e\u0434\u0438\u043d\u0430\u00a0<strong>\u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u043d\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0441\u0442\u0430\u0432\u0430 \u041a\u0438\u0440\u0447\u043e \u0410\u0442\u0430\u043d\u0430\u0441\u043e\u0432<\/strong>, \u043f\u043e\u0434 \u0447\u0438\u0435\u0442\u043e \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0432 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0435\u043d\u0438\u0435 \u043d\u0430\u00a0<strong>30 \u0433\u043e\u0434\u0438\u043d\u0438<\/strong>\u00a0\u043d\u0430\u0441\u0442\u044a\u043f\u0432\u0430\u0442 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u043d\u0438 \u043f\u0440\u043e\u043c\u0435\u043d\u0438 \u0432 \u0441\u0442\u0430\u0442\u0443\u0442\u0430 \u043d\u0430 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u0438 \u0441\u0435 \u0437\u0430\u0432\u043e\u044e\u0432\u0430\u0442 \u043f\u043e\u0440\u0435\u0434\u0438\u0446\u0430 \u043e\u0442 \u0443\u0441\u043f\u0435\u0445\u0438.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 1977-79 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u0435 \u0432\u043d\u0435\u0434\u0440\u044f\u0432\u0430\u00a0<strong>\u043d\u043e\u0432\u0430 \u0443\u0447\u0435\u0431\u043d\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430 \u043f\u043e \u201e\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0410\u0421\u041c\u201d<\/strong>, \u043a\u043e\u044f\u0442\u043e \u0441\u0435 \u043f\u0440\u0435\u0432\u0440\u044a\u0449\u0430 \u0432 \u0431\u0430\u0437\u0430 \u0437\u0430 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0442\u043e \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430. \u0417\u0430 \u043f\u044a\u0440\u0432\u0438 \u043f\u044a\u0442 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u0437\u0430\u0432\u044a\u0440\u0448\u0432\u0430\u0442 \u0443\u0447\u0435\u043d\u0438\u0446\u0438 \u043f\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e\u0441\u0442\u0442\u0430 \u201e\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0441\u0442 \u043d\u0430 \u0410\u0421\u041c\u201d.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u043b\u043e\u0432\u0434\u0438\u0432\u0441\u043a\u0430\u0442\u0430 \u041c\u0413 \u0435<strong>\u00a0\u043f\u044a\u0440\u0432\u0430<\/strong>\u00a0\u043f\u043e \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0438 \u043c\u0435\u0436\u0434\u0443 \u0441\u0440\u0435\u0434\u043d\u0438\u0442\u0435 \u0443\u0447\u0435\u0431\u043d\u0438 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u043f\u0440\u0435\u0437 1980 \u0433\u043e\u0434\u0438\u043d\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u043e \u0441\u044a\u0449\u043e\u0442\u043e \u0432\u0440\u0435\u043c\u0435 \u0411\u0410\u041d \u043f\u0440\u0438\u0435\u043c\u0430 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u0437\u0430 \u043f\u0430\u0440\u0442\u043d\u044c\u043e\u0440 \u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043d\u0430\u0443\u0447\u043d\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u0438.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 1980 \u0433. \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u043d\u0438 \u043f\u0435\u0447\u0435\u043b\u0438 \u043f\u044a\u0440\u0432\u043e \u043c\u044f\u0441\u0442\u043e \u0441\u0440\u0435\u0434 \u0432\u0441\u0438\u0447\u043a\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u0438 \u00a0\u043d\u0430 \u0441\u044a\u0441\u0442\u0435\u0437\u0430\u043d\u0438\u0435 \u043f\u043e \u043f\u0440\u0438\u0440\u043e\u0434\u043e\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0442\u0435 \u043d\u0430\u0443\u043a\u0438.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u044a\u0440\u0432\u0430\u0442\u0430 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u0432\u0438\u0434\u0435\u043e\u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u043d\u0430 \u0432\u0440\u044a\u0437\u043a\u0430 \u043c\u0435\u0436\u0434\u0443 \u0421\u043e\u0444\u0438\u044f \u0438 \u041f\u043b\u043e\u0432\u0434\u0438\u0432 \u0437\u0430 \u0446\u0435\u043b\u0438\u0442\u0435 \u043d\u0430 \u0443\u0447\u0435\u0431\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0441 \u0435 \u043e\u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u0430 \u0441\u044a\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u0415\u0426\u041c\u041c \u043d\u0430 \u0411\u0410\u041d \u043f\u0440\u0435\u0437 1981 \u0433\u043e\u0434\u0438\u043d\u0430. \u0420\u0430\u0437\u043a\u0440\u0438\u0442\u0430 \u0435 \u0438 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u0430\u0442\u0430 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u043f\u0430\u0440\u0430\u043b\u0435\u043b\u043a\u0430 \u043f\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e\u0441\u0442\u0442\u0430 \u201e\u041c\u0438\u043a\u0440\u043e\u043f\u0440\u043e\u0446\u0435\u0441\u043e\u0440\u0438\u201d.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:columns -->\r\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66.66%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis: 66.66%;\"><!-- wp:paragraph -->\r\n<p><strong>\u041f\u0440\u0435\u0437 1983 \u0433\u043e\u0434\u0438\u043d\u0430 \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0435 \u043e\u0442\u043a\u0440\u0438\u0442 \u043d\u0430\u0439-\u0433\u043e\u043b\u0435\u043c\u0438\u044f\u0442 \u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e-\u0438\u0437\u0447\u0438\u0441\u043b\u0438\u0442\u0435\u043b\u0435\u043d \u0446\u0435\u043d\u0442\u044a\u0440<\/strong> \u0432 \u0431\u044a\u043b\u0433\u0430\u0440\u0441\u043a\u043e \u0441\u0440\u0435\u0434\u043d\u043e \u0443\u0447\u0438\u043b\u0438\u0449\u0435 \u0441 \u043f\u044a\u0440\u0432\u0438\u044f \u0437\u0430 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u043a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u0435\u043d \u043a\u043b\u0430\u0441. \u0412 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442 \u043d\u0430 \u0442\u043e\u0432\u0430 \u043f\u0440\u0435\u0437 1984 \u0433\u043e\u0434\u0438\u043d\u0430 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u0441\u0442\u0430\u0432\u0430 \u0434\u043e\u043c\u0430\u043a\u0438\u043d \u043d\u0430 \u0434\u0432\u0435 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0438 \u0435\u0434\u043d\u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f \u043f\u043e \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u041f\u041a \u0432 \u0443\u0447\u0435\u0431\u043d\u0438\u044f \u043f\u0440\u043e\u0446\u0435\u0441. \u0413\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0435 \u0443\u0447\u0440\u0435\u0434\u0438\u0442\u0435\u043b \u0438 \u0434\u043e\u043c\u0430\u043a\u0438\u043d \u043d\u0430 \u041f\u044a\u0440\u0432\u0438\u044f \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0442\u0443\u0440\u043d\u0438\u0440 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 \u043f\u0440\u0435\u0437 1985 \u0433\u043e\u0434\u0438\u043d\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph {\"align\":\"right\"} -->\r\n<p class=\"has-text-align-right\"><strong>\u041f\u0440\u0435\u0437 1983-85 \u0433\u043e\u0434\u0438\u043d\u0430<\/strong><strong>\u00a0\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d \u043d\u043e\u0432 \u0443\u0447\u0435\u0431\u0435\u043d \u043a\u043e\u0440\u043f\u0443\u0441<\/strong>\u00a0\u0437\u0430 \u043d\u0443\u0436\u0434\u0438\u0442\u0435 \u043d\u0430 \u0443\u0447\u0435\u0431\u043d\u043e-\u043f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 (\u0423\u041f\u041a), \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d \u0441\u044a\u0441 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430 \u041c\u0422\u0411. \u0422\u043e\u0439 \u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d \u0441 16 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438, \u0440\u0430\u0431\u043e\u0442\u0438\u043b\u043d\u0438\u0446\u0438 \u0438 \u043a\u043b\u0430\u0441\u043d\u0438 \u0441\u0442\u0430\u0438, \u043a\u043e\u0438\u0442\u043e \u0441\u0430 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d\u0438 \u0441 \u043d\u0430\u0439 \u2013 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u0442\u0430 \u0442\u0435\u0445\u043d\u0438\u043a\u0430.<\/p>\r\n<!-- \/wp:paragraph --><\/div>\r\n<!-- \/wp:column -->\r\n\r\n<!-- wp:column {\"width\":\"33.33%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis: 33.33%;\"><!-- wp:image {\"align\":\"center\",\"id\":6534,\"width\":236,\"height\":285,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\r\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" class=\"wp-image-6534\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history3.bmp\" alt=\"\" width=\"236\" height=\"285\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history3.bmp 206w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history3-10x12.jpg 10w\" sizes=\"(max-width: 236px) 100vw, 236px\" \/><\/figure>\r\n<!-- \/wp:image --><\/div>\r\n<!-- \/wp:column --><\/div>\r\n<!-- \/wp:columns -->\r\n\r\n<!-- wp:image {\"align\":\"center\",\"id\":6536,\"width\":741,\"height\":486,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\r\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" class=\"wp-image-6536\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history4.bmp\" alt=\"\" width=\"741\" height=\"486\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history4.bmp 607w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history4-300x197.jpg 300w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history4-18x12.jpg 18w\" sizes=\"(max-width: 741px) 100vw, 741px\" \/><\/figure>\r\n<!-- \/wp:image -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041e\u0442 \u0441\u0440\u0435\u0434\u0430\u0442\u0430 \u043d\u0430 \u0441\u044a\u0449\u043e\u0442\u043e \u0434