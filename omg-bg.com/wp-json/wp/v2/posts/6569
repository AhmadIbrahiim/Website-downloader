043e\u0444\u0435\u0441\u0438\u044f\u0442\u0430 \u201e\u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440-\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0441\u0442 \u043d\u0430 \u0415\u0418\u041c\u201d, \u043a\u0430\u0442\u043e \u0442\u0443\u043a \u0441\u0435 \u043f\u0438\u0448\u0430\u0442 \u0438 \u043f\u044a\u0440\u0432\u0438\u0442\u0435 \u0443\u0447\u0435\u0431\u043d\u0438\u0446\u0438 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 \u0437\u0430 \u0441\u0440\u0435\u0434\u043d\u043e\u0442\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 1987 \u0433\u043e\u0434\u0438\u043d\u0430 \u0432 \u041e\u041c\u0413 \u0441\u0435 \u043e\u0442\u043a\u0440\u0438\u0432\u0430\u0442 \u043f\u044a\u0440\u0432\u0438\u0442\u0435 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u043d\u0438 \u043f\u0430\u0440\u0430\u043b\u0435\u043b\u043a\u0438 \u0441 \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0432\u043d\u043e \u0438\u0437\u0443\u0447\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u0441\u0440\u0435\u0434 \u043f\u0440\u043e\u0444\u0438\u043b\u0438\u0440\u0430\u043d\u0438\u0442\u0435 \u0443\u0447\u0438\u043b\u0438\u0449\u0430. \u0412 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442 \u043d\u0430 \u0442\u043e\u0432\u0430 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u043d\u0438\u0435 \u043e\u0442 1989 \u0433\u043e\u0434\u0438\u043d\u0430 \u043f\u0440\u0438\u0435\u043c\u044a\u0442 \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0432\u043a\u043b\u044e\u0447\u0432\u0430 \u043f\u0430\u0440\u0430\u043b\u0435\u043b\u043a\u0438 \u0441 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438, \u043d\u0435\u043c\u0441\u043a\u0438 \u0438 \u0444\u0440\u0435\u043d\u0441\u043a\u0438 \u0435\u0437\u0438\u043a.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 1987\/88 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u044a\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u043d\u0430\u0443\u0447\u043d\u0438 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0438 \u043d\u0430 \u0411\u0410\u041d \u0438 \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u043d\u0438\u044f \u0446\u0435\u043d\u0442\u044a\u0440 \u043f\u043e \u043b\u0430\u0437\u0435\u0440\u043d\u0430 \u0442\u0435\u0445\u043d\u0438\u043a\u0430 \u0441\u0430 \u0441\u044a\u0441\u0442\u0430\u0432\u0435\u043d\u0438 \u043f\u043b\u0430\u043d \u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0437\u0430 \u043d\u043e\u0432\u0430\u0442\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u044f \u201e\u041f\u0440\u043e\u0435\u043a\u0442\u0430\u043d\u0442-\u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433 \u043d\u0430 \u0441\u0445\u0435\u043c\u043d\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0438\u043a\u0430\u201d.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0412 \u043a\u0440\u0430\u044f \u043d\u0430 80-\u0442\u0435 \u0433\u043e\u0434\u0438\u043d\u0438 \u0437\u0430\u043f\u043e\u0447\u0432\u0430\u0442 \u0440\u0435\u0448\u0438\u0442\u0435\u043b\u043d\u0438 \u0441\u0442\u044a\u043f\u043a\u0438 \u0437\u0430 \u043e\u0442\u043a\u0440\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 \u043d\u043e\u0432\u0438 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u0438 \u043e\u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u041c\u0422\u0411 \u043d\u0430 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u2013 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u0442 \u0441\u0435 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0438 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430, \u0440\u043e\u0431\u043e\u0442\u0435\u0445\u043d\u0438\u043a\u0430 \u041a\u0418\u041f\u0421, \u0438\u0437\u043e\u0431\u0440\u0430\u0437\u0438\u0442\u0435\u043b\u043d\u043e \u0438\u0437\u043a\u0443\u0441\u0442\u0432\u043e, \u0441\u044a\u0437\u0434\u0430\u0432\u0430 \u0441\u0435 \u043b\u043e\u043a\u0430\u043b\u043d\u0430 \u043c\u0440\u0435\u0436\u0430 \u0437\u0430 16-\u0431\u0438\u0442\u043e\u0432\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u043d\u0438 \u043a\u043e\u043c\u043f\u044e\u0442\u0440\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438.<\/p>\r\n<!-- \/wp:paragraph --><\/div>\r\n<!-- \/wp:column -->\r\n\r\n<!-- wp:column {\"width\":\"33.33%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis: 33.33%;\"><!-- wp:image {\"id\":6542,\"width\":340,\"height\":374,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\r\n<figure class=\"wp-block-image size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" class=\"wp-image-6542\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history5.jpg\" alt=\"\" width=\"340\" height=\"374\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history5.jpg 531w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history5-272x300.jpg 272w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/history5-11x12.jpg 11w\" sizes=\"(max-width: 340px) 100vw, 340px\" \/><\/figure>\r\n<!-- \/wp:image --><\/div>\r\n<!-- \/wp:column --><\/div>\r\n<!-- \/wp:columns -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 \u0446\u044f\u043b\u043e\u0442\u043e \u0432\u0440\u0435\u043c\u0435 \u043e\u0442 1980-88 \u0433\u043e\u0434\u0438\u043d\u0430 \u043e\u0442\u0431\u043e\u0440\u044a\u0442 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u043d\u0430 \u041e\u041c\u0413 \u0435 \u043d\u043e\u0441\u0438\u0442\u0435\u043b \u043d\u0430 \u043a\u0443\u043f\u0430\u0442\u0430 \u0437\u0430 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u0435\u043d \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b \u043d\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0442\u0435 \u0443\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438, \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u043d\u0438 \u043e\u0442 \u0421\u044a\u044e\u0437\u0430 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0446\u0438\u0442\u0435 \u0432 \u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 1993 \u0433\u043e\u0434\u0438\u043d\u0430 \u0437\u0430 \u043f\u044a\u0440\u0432\u0438 \u043f\u044a\u0442 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u0441\u0435 \u0432\u043d\u0435\u0434\u0440\u044f\u0432\u0430 \u0443\u0447\u0435\u0431\u043d\u0438\u044f\u0442 \u043f\u0440\u043e\u0444\u0438\u043b \u201e\u041a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u043d\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0430 \u0438 \u0434\u0438\u0437\u0430\u0439\u043d\u201d \u0438 \u0435 \u043e\u0442\u043a\u0440\u0438\u0442 \u043f\u044a\u0440\u0432\u0438\u044f\u0442 \u043a\u043b\u0430\u0441 \u043f\u043e \u0442\u0430\u0437\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u043e\u0441\u0442.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041d\u043e\u0432 \u043c\u043e\u043c\u0435\u043d\u0442 \u0432 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u0442\u043e \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 \u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u043a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u0435\u043d \u043a\u0430\u0431\u0438\u043d\u0435\u0442 \u0441 \u041f\u041a IBM-486 \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u044a\u043b\u0435\u043d \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 \u043e\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0438 \u0437\u0430 \u0443\u0441\u0432\u043e\u044f\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p><strong>\u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0437\u0430 \u0443\u0441\u043f\u0435\u0445\u0438\u0442\u0435 \u043d\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0435 \u0434\u043e\u043c\u0430\u043a\u0438\u043d\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0442\u0435 \u0425\u0406\u0406-\u0442\u0430 \u0411\u0430\u043b\u043a\u0430\u043d\u0441\u043a\u0430 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 (1995 \u0433.)<\/strong>, \u0425\u0425V\u0406-\u0442\u0430 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043f\u0440\u043e\u043b\u0435\u0442\u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f \u043d\u0430 \u0421\u044a\u044e\u0437\u0430 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0446\u0438\u0442\u0435 \u0432 \u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f (1997 \u0433.) \u0438 \u0411\u0430\u043b\u043a\u0430\u043d\u0441\u043a\u0430\u0442\u0430 \u043c\u043b\u0430\u0434\u0435\u0436\u043a\u0430 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0430 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 (1999 \u0433.). \u0410 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 1999-2001 \u0433\u043e\u0434\u0438\u043d\u0430 \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u0442 \u043f\u043e \u043f\u043b\u0430\u043d\u0430 \u043d\u0430 \u041c\u041e\u041d \u0442\u0440\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0441\u044a\u0441\u0442\u0435\u0437\u0430\u043d\u0438\u044f \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u0435\u0437 1997 \u0433\u043e\u0434\u0438\u043d\u0430 \u041e\u041c\u0413 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u0441\u0442\u0432\u0430 \u0441\u044a\u0441 \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0435\u043a\u0442 \u0438 \u043f\u0435\u0447\u0435\u043b\u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0441 \u043f\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430\u0442\u0430 PHAR\u0415 \u2013 BG \u2013 \u201e\u0423\u0441\u044a\u0432\u044a\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0442\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u201d \u0437\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u044f\u0442\u0430 \u201e\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0441\u0442\u201d. \u0422\u043e\u0432\u0430 \u043d\u0430\u043b\u0430\u0433\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u043d\u043e \u043e\u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u043d\u0430\u0442\u0430 \u0442\u0435\u0445\u043d\u0438\u043a\u0430 \u0432 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e. \u0412 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442 \u043d\u0430 \u0434\u0430\u0440\u0438\u0442\u0435\u043b\u0441\u043a\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u043d\u0438\u044f \u0441\u0440\u0435\u0434 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0438 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438 \u043d\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0441\u0435 \u0437\u0430\u043a\u0443\u043f\u0443\u0432\u0430\u0442 \u043c\u043e\u0434\u0435\u0440\u043d\u0438 \u041f\u041a \u201ePentium\u201d. \u0414\u043d\u0435\u0441 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u0440\u0430\u0437\u043f\u043e\u043b\u0430\u0433\u0430 \u0441 \u0434\u0435\u0432\u0435\u0442 \u0437\u0430\u043b\u0438, \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d\u0438 \u0441 \u043a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u043d\u0430 \u0442\u0435\u0445\u043d\u0438\u043a\u0430, \u043e\u0442\u0433\u043e\u0432\u0430\u0440\u044f\u0449\u0430 \u043d\u0430 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0438\u0442\u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0438 \u043d\u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p><strong>\u041e\u0442 2002 \u0433\u043e\u0434\u0438\u043d\u0430<\/strong> (\u043f\u043e \u0441\u043b\u0443\u0447\u0430\u0439 20-\u0433\u043e\u0434\u0438\u0448\u043d\u0438\u043d\u0430\u0442\u0430 \u043e\u0442 \u043f\u0440\u0435\u043c\u0435\u0441\u0442\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0432 \u0441\u0435\u0433\u0430\u0448\u043d\u0430\u0442\u0430 \u045d \u0441\u0433\u0440\u0430\u0434\u0430) \u043f\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u0423\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u044f \u0441\u044a\u0432\u0435\u0442 \u0438 \u043d\u0430 \u0423\u0447\u0438\u043b\u0438\u0449\u043d\u043e\u0442\u043e \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0432 \u041e\u041c\u0413 \u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430 \u0432\u044a\u0442\u0440\u0435\u0448\u043d\u043e\u0443\u0447\u0438\u043b\u0438\u0449\u0435\u043d \u043f\u0440\u0435\u0433\u043b\u0435\u0434\u00a0<strong>\u201e\u0423\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u2013 \u043c\u043e\u0439 \u0432\u0442\u043e\u0440\u0438 \u0434\u043e\u043c\u201d<\/strong>. \u0412 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442 \u0441\u0430 \u0440\u0435\u043c\u043e\u043d\u0442\u0438\u0440\u0430\u043d\u0438 32 \u043a\u043b\u0430\u0441\u043d\u0438 \u0441\u0442\u0430\u0438, 18 \u043e\u0442 \u043a\u043e\u0438\u0442\u043e \u0446\u044f\u043b\u043e\u0441\u0442\u043d\u043e. \u0417\u0430 \u0434\u0430 \u0441\u0435 \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u0430 \u0438\u043d\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0434\u0430 \u043f\u043e\u0434\u043e\u0431\u0440\u044f\u0432\u0430\u0442 \u0441\u0432\u043e\u044f \u201e\u0432\u0442\u043e\u0440\u0438 \u0434\u043e\u043c\u201d, \u0432 \u043e\u0431\u043d\u043e\u0432\u0435\u043d\u0438\u0442\u0435 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0438 \u0435 \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0430 \u043a\u0430\u0431\u0435\u043b\u043d\u0430 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u044f, \u0441 \u043a\u043e\u0435\u0442\u043e \u041e\u041c\u0413 \u0441\u0442\u0430\u0432\u0430 \u043f\u044a\u0440\u0432\u043e\u0442\u043e \u0443\u0447\u0438\u043b\u0438\u0449\u0435 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430, \u043e\u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0438\u043b\u043e \u0442\u0430\u0437\u0438 \u043d\u043e\u0432\u0430\u0442\u043e\u0440\u0441\u043a\u0430 \u0438\u0434\u0435\u044f.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041e\u0442 2002 \u0433\u043e\u0434\u0438\u043d\u0430 \u0432 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u043f\u043e\u0434 \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u0442\u043e \u043d\u0430 \u0423\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u044f \u0441\u044a\u0432\u0435\u0442 \u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430 \u0414\u0435\u043d \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0442\u043e \u0441\u0430\u043c\u043e\u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u0432 \u043a\u043e\u0439\u0442\u043e \u0431\u043b\u0438\u0437\u043e 300 \u0443\u0447\u0435\u043d\u0438\u0446\u0438 \u0437\u0430\u0435\u043c\u0430\u0442 \u0434\u043b\u044a\u0436\u043d\u043e\u0441\u0442\u0438\u0442\u0435 \u043d\u0430 \u0443\u0447\u0438\u0442\u0435\u043b\u0438\u0442\u0435 \u0438 \u0443\u0447\u0438\u043b\u0438\u0449\u043d\u043e\u0442\u043e \u0440\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e, \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442, \u0438\u0437\u043f\u0438\u0442\u0432\u0430\u0442, \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0438\u0440\u0430\u0442 \u0443\u0447\u0438\u043b\u0438\u0449\u043d\u0438\u044f \u0436\u0438\u0432\u043e\u0442 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0442 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u043a\u0430\u0442\u043e \u0441\u0432\u043e\u0435.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0410\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u044a\u0442, \u043a\u043e\u0439\u0442\u043e \u041e\u041c\u0413 \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201d \u0438\u043c\u0430 \u0432 \u041f\u043b\u043e\u0432\u0434\u0438\u0432 \u0438 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430, \u043f\u0440\u043e\u043b\u0438\u0447\u0430\u0432\u0430 \u043d\u0430\u0439-\u0432\u0435\u0447\u0435 \u043f\u0440\u0435\u0437 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0442\u0435 \u0433\u043e\u0434\u0438\u043d\u0438, \u043a\u043e\u0433\u0430\u0442\u043e \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e \u0441\u0435 \u043f\u0440\u0435\u0432\u0440\u044a\u0449\u0430 \u0432\u044a\u0432 \u0432\u043e\u0434\u0435\u0449\u043e \u043c\u044f\u0441\u0442\u043e \u043d\u0430 \u0440\u0435\u0434\u0438\u0446\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0438\u0437\u044f\u0432\u0438.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p><strong>\u041f\u0440\u0435\u0437 \u0443\u0447\u0435\u0431\u043d\u0430\u0442\u0430 2003\/04 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u0442 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0442\u0443\u0440\u043d\u0438\u0440 \u201e\u041d\u0430\u0439-\u0434\u043e\u0431\u044a\u0440 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u0441\u0442\u201d<\/strong>\u00a0\u043f\u043e \u0441\u043b\u0443\u0447\u0430\u0439 100-\u0433\u043e\u0434\u0438\u0448\u043d\u0438\u043d\u0430\u0442\u0430 \u043e\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0414\u0436\u043e\u043d \u0410\u0442\u0430\u043d\u0430\u0441\u043e\u0432, \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0442\u0443\u0440\u043d\u0438\u0440 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 \u201e\u0414\u0438\u043c\u043e \u041c\u0430\u043b\u0435\u0448\u043a\u043e\u0432\u201d, \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0443\u0447\u0440\u0435\u0434\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0430\u0442\u0430 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0430 \u0421\u041c\u0411, \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0442\u0443\u0440\u043d\u0438\u0440 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 \u201e\u0420\u0443\u043c\u0435\u043d \u0413\u0440\u043e\u0437\u0434\u0430\u043d\u043e\u0432\u201d, \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f \u043f\u043e \u0444\u0438\u0437\u0438\u043a\u0430, \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0442\u0443\u0440\u043d\u0438\u0440 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430, \u0411\u0430\u043b\u043a\u0430\u043d\u0441\u043a\u0430 \u043e\u043b\u0438\u043c\u043f\u0438\u0430\u0434\u0430 \u043f\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0412 \u041e\u041c\u0413 \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201d \u0435 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0430 \u0431\u043b\u0430\u0433\u043e\u043f\u0440\u0438\u044f\u0442\u043d\u0430 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0437\u0430 \u043f\u044a\u0440\u0432\u0438\u0442\u0435 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438 \u0442\u0440\u0435\u043f\u0435\u0442\u0438 \u0438 \u0442\u044a\u0440\u0441\u0435\u043d\u0438\u044f \u043d\u0430 \u043c\u043b\u0430\u0434\u0438\u0442\u0435 \u0445\u043e\u0440\u0430 \u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0415\u0436\u0435\u0433\u043e\u0434\u043d\u043e \u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u0442\u00a0<strong>\u0414\u0435\u043d \u043d\u0430 \u0442\u0430\u043b\u0430\u043d\u0442\u0430<\/strong>\u00a0\u0438\u00a0<strong>\u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0435\u043d \u043a\u043e\u043d\u043a\u0443\u0440\u0441 \u201e\u0427\u0430\u0432\u0434\u0430\u0440 \u0414\u0438\u043c\u0438\u0442\u0440\u043e\u0432 \u2013 \u0427\u0430\u0440\u043b\u0438\u201d<\/strong>\u00a0\u0437\u0430 \u0438\u0437\u044f\u0432\u0430 \u043d\u0430 \u043f\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0442\u0430 \u0432 \u0438\u0437\u043a\u0443\u0441\u0442\u0432\u043e\u0442\u043e \u0438 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u0442\u0430, \u0438\u0437\u043b\u043e\u0436\u0431\u0438 \u043d\u0430 \u043a\u043e\u043c\u043f\u044e\u0442\u044a\u0440\u043d\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0430. \u041f\u043e\u0435\u0442\u0438\u0447\u043d\u0438\u0442\u0435 \u0441\u0438 \u0438 \u0435\u0441\u0435\u0438\u0441\u0442\u0438\u0447\u043d\u0438 \u0442\u0432\u043e\u0440\u0431\u0438 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0438\u0437\u0434\u0430\u0432\u0430\u0442 \u0432 \u0441\u0431\u043e\u0440\u043d\u0438\u0446\u0438, \u0430\u043b\u043c\u0430\u043d\u0430\u0441\u0438, \u043a\u043d\u0438\u0433\u0438, \u0432\u0435\u0441\u0442\u043d\u0438\u0446\u0438. \u0427\u0435\u0441\u0442\u0438\u0442\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u044f \u0432 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0438, \u0438\u0437\u043b\u043e\u0436\u0431\u0438, \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u0438, \u0441\u043f\u0435\u0447\u0435\u043b\u0435\u043d\u0438\u0442\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0438 \u043d\u0430 \u043e\u0431\u0449\u0438\u043d\u0441\u043a\u0438, \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0444\u043e\u0440\u0443\u043c\u0438 \u0437\u0430 \u0441\u0442\u0438\u0445\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u044f, \u0435\u0441\u0435\u0442\u0430, \u043a\u0430\u0440\u0442\u0438\u043d\u0438 \u0434\u043e\u043d\u0430\u0441\u044f\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f \u0438 \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442 \u043d\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430. \u0422\u0435\u0437\u0438 \u0438\u0437\u044f\u0432\u0438 \u0441\u0430 \u043d\u0435 \u043f\u043e-\u043c\u0430\u043b\u043a\u043e \u0437\u043d\u0430\u0447\u0438\u043c\u0438 \u043e\u0442 \u0443\u0441\u043f\u0435\u0445\u0438\u0442\u0435 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0442\u0430 \u043d\u0430 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\u0442\u0430 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430\u0442\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0421\u044a\u0441 \u0441\u0432\u043e\u0438\u0442\u0435 \u0432\u0438\u0441\u043e\u043a\u043e\u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u0430\u043d\u0438 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0438 \u0438 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043d\u0430 \u0431\u0430\u0437\u0430 \u0432\u0435\u0447\u0435 \u043d\u0430\u0434 50 \u0433\u043e\u0434\u0438\u043d\u0438 \u041e\u041c\u0413 \u0441\u044a\u0437\u0434\u0430\u0432\u0430 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u0437\u0430 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u043d\u0430 \u0441\u0432\u043e\u0438\u0442\u0435 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438. \u0412 \u043d\u0435\u0433\u043e \u0441\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u0442\u043e \u0441\u0438 \u043d\u0430\u0434 6000 \u043c\u043b\u0430\u0434\u0435\u0436\u0438 \u0438 \u0434\u0435\u0432\u043e\u0439\u043a\u0438, \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043b\u0438 \u0441\u0435 \u0432\u044a\u0432 \u0432\u0441\u0438\u0447\u043a\u0438 \u0441\u0444\u0435\u0440\u0438 \u043d\u0430 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u0438\u044f \u0436\u0438\u0432\u043e\u0442 \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u0438 \u0447\u0443\u0436\u0431\u0438\u043d\u0430.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:columns -->\r\n<div class=\"wp-block-columns\"><!-- wp:column -->\r\n<div class=\"wp-block-column\"><!-- wp:image {\"id\":6548,\"width\":687,\"height\":366,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\r\n<figure class=\"wp-block-image size-full is-resized\"><img fetchpriority=\"high\" decoding=\"async\" class=\"wp-image-6548\" src=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/smart1.jpg\" alt=\"\" width=\"687\" height=\"366\" srcset=\"https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/smart1.jpg 604w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/smart1-300x160.jpg 300w, https:\/\/omg-bg.com\/wp-content\/uploads\/2023\/04\/smart1-18x10.jpg 18w\" sizes=\"(max-width: 687px) 100vw, 687px\" \/><\/figure>\r\n<!-- \/wp:image --><\/div>\r\n<!-- \/wp:column -->\r\n\r\n<!-- wp:column -->\r\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\r\n<p>\u0412\u0441\u044f\u043a\u0430 \u0433\u043e\u0434\u0438\u043d\u0430 \u043d\u0430\u0434 95% \u043e\u0442 \u0437\u0430\u0432\u044a\u0440\u0448\u0432\u0430\u0449\u0438\u0442\u0435 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u0442 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435\u0442\u043e \u0441\u0438 \u0432\u044a\u0432 \u0432\u0438\u0441\u0448\u0438 \u0443\u0447\u0435\u0431\u043d\u0438 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0443 \u043d\u0430\u0441, \u0432 \u0413\u0435\u0440\u043c\u0430\u043d\u0438\u044f, \u0412\u0435\u043b\u0438\u043a\u043e\u0431\u0440\u0438\u0442\u0430\u043d\u0438\u044f, \u0424\u0440\u0430\u043d\u0446\u0438\u044f, \u041d\u0438\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0438\u044f \u0438 \u0421\u0410\u0429. \u0412 \u0441\u0432\u043e\u044f\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0438\u043c\u0430 \u043d\u0430\u0434 500 \u043c\u0435\u0434\u0430\u043b\u0438\u0441\u0442\u0438 \u043e\u0442 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0444\u043e\u0440\u0443\u043c\u0438, \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u043a\u043e\u0438\u0442\u043e \u0435 \u0438\u0437\u0440\u0430\u0437\u0435\u043d\u0430 \u0447\u0440\u0435\u0437 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0430\u0442\u0430 \u201e\u0421\u0442\u0435\u043d\u0430 \u043d\u0430 \u0441\u043b\u0430\u0432\u0430\u0442\u0430\u201d.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0412\u0441\u0438\u0447\u043a\u0438 \u0442\u0435\u0437\u0438 \u0443\u0441\u043f\u0435\u0445\u0438 \u0443\u0442\u0432\u044a\u0440\u0436\u0434\u0430\u0432\u0430\u0442 \u041e\u041c\u0413 \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201d \u043a\u0430\u0442\u043e \u0435\u0434\u043d\u043e \u043e\u0442 \u043d\u0430\u0439-\u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u043d\u0438\u0442\u0435 \u0438 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u043d\u0438 \u0443\u0447\u0435\u0431\u043d\u0438 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430, \u0433\u043e\u043b\u044f\u043c\u0430 \u0447\u0430\u0441\u0442 \u043e\u0442 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438\u0442\u0435 \u043d\u0430 \u043a\u043e\u0435\u0442\u043e \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442 \u043a\u044a\u043c \u0438\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u043d\u0438\u044f \u0435\u043b\u0438\u0442, \u0438\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u0449 \u043e\u0431\u043b\u0438\u043a\u0430 \u043d\u0430 \u0441\u044a\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0447\u043d\u0430 \u0411\u044a\u043b\u0433\u0430\u0440\u0438\u044f.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0413\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u0441 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0438\u0442\u0435 \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u0442\u043e \u0438 \u0441 \u043f\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0442\u0430 \u0441\u0438, \u0430 \u0438\u043c\u0435\u043d\u043d\u043e 65 \u043c\u0435\u0434\u0430\u043b\u0438\u0441\u0442\u0438 \u043e\u0442 \u043f\u0440\u0435\u0441\u0442\u0438\u0436\u043d\u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0444\u043e\u0440\u0443\u043c\u0438, \u043e\u043f\u0438\u0441\u0430\u043d\u0438 \u0432 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0430\u0442\u0430 \u201c\u0421\u0442\u0435\u043d\u0430 \u043d\u0430 \u0441\u043b\u0430\u0432\u0430\u0442\u0430\u201d.<\/p>\r\n<\/div>\r\n<\/div>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p><strong>\u041e\u0442 2003 \u0432 \u041c\u0413 \u0441\u0430 \u0432\u044a\u0432\u0435\u0434\u0435\u043d\u0438 \u0443\u043d\u0438\u0444\u043e\u0440\u043c\u0438 \u0437\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435.<\/strong><\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0442\u0435 \u043f\u0430\u0440\u0430\u043b\u0435\u043b\u043a\u0438 \u0441\u0430 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0438 \u043f\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430 \u0424\u0410\u0420 \u043f\u0440\u0435\u0437 1997 \u0433\u043e\u0434\u0438\u043d\u0430. \u041a\u043e\u043b\u0435\u043a\u0442\u0438\u0432\u044a\u0442 \u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0430\u043b \u0432 \u0441\u044a\u0437\u0434\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0443\u0447\u0435\u0431\u043d\u0438\u044f \u043f\u043b\u0430\u043d \u043d\u0430 \u0442\u0430\u0437\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u044f.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0412\u0441\u044f\u043a\u0430 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u0442 &#8222;\u0414\u0435\u043d \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0442\u043e \u0441\u0430\u043c\u043e\u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u0442\u043e&#8220;, &#8222;\u0414\u0435\u043d \u043d\u0430 \u0442\u0430\u043b\u0430\u043d\u0442\u0430&#8220;, \u0441\u043f\u043e\u0440\u0442\u0435\u043d \u043f\u0440\u0430\u0437\u043d\u0438\u043a, \u041a\u043e\u043d\u043a\u0443\u0440\u0441 \u0437\u0430 \u043d\u0430\u0439-\u0445\u0443\u0431\u0430\u0432\u0430 \u0441\u0442\u0430\u044f &#8211; &#8222;\u0423\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e &#8211; \u043c\u043e\u0439 \u0432\u0442\u043e\u0440\u0438 \u0434\u043e\u043c&#8220; , \u0430 \u0441\u044a\u0449\u043e \u0438 \u0444\u0443\u0442\u0431\u043e\u043b\u0435\u043d \u0442\u0443\u0440\u043d\u0438\u0440. \u041c\u0413 \u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440 \u043d\u0430 \u0434\u0432\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u043d\u0438 \u0442\u0443\u0440\u043d\u0438\u0440\u0430 &#8211; \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0442\u0443\u0440\u043d\u0438\u0440\u0438 \u043f\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 &#8222;\u0414\u0438\u043c\u043e \u041c\u0430\u043b\u0435\u0448\u043a\u043e\u0432&#8220; \u0438 \u0420\u0443\u043c\u0435\u043d \u0413\u0440\u043e\u0437\u0434\u0430\u043d\u043e\u0432&#8220; .<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p><strong>\u0414\u0418\u041c\u041e \u041c\u0410\u041b\u0415\u0428\u041a\u041e\u0412 &#8211; \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u043d\u0430 \u041e\u041c\u0413 \u0432 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 1971 &#8211; 1975 \u0433.<\/strong><\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:columns -->\r\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"66.66%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis: 66.66%;\"><!-- wp:paragraph -->\r\n<p>\u201e\u041e\u0442 \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u0442\u0430 \u043d\u0430 \u0432\u0440\u0435\u043c\u0435\u0442\u043e, \u043a\u043e\u0433\u0430\u0442\u043e \u0441\u0438 \u043c\u0438\u0441\u043b\u044f \u0437\u0430 \u043d\u0430\u0447\u0430\u043b\u043e\u0442\u043e, \u0438\u0441\u043a\u0430\u043c \u0441\u044a\u0440\u0434\u0435\u0447\u043d\u043e \u0434\u0430 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043d\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u043a\u043e\u043b\u0435\u0433\u0438, \u0441 \u043a\u043e\u0438\u0442\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0445\u043c\u0435 \u043e\u0441\u043d\u043e\u0432\u0438\u0442\u0435 \u043d\u0430 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u0442\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f \u0438 \u0438\u0437\u0431\u0440\u0430\u0445\u043c\u0435 \u043d\u0435\u0438\u043d \u0430\u0432\u0442\u043e\u0440\u0438\u0442\u0435\u0442\u0435\u043d \u043f\u0430\u0442\u0440\u043e\u043d.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u0438\u0445\u043c\u0435 \u0437\u0430\u0434\u0440\u0443\u0436\u043d\u043e \u0438 \u0437\u0430\u0435\u0434\u043d\u043e. \u0412\u0441\u0438\u0447\u043a\u0438 \u2013 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0446\u0438, \u0444\u0438\u043b\u043e\u043b\u043e\u0437\u0438, \u0438\u0441\u0442\u043e\u0440\u0438\u0446\u0438, \u0431\u0438\u043e\u043b\u043e\u0437\u0438, \u0444\u0438\u0437\u0438\u0446\u0438, \u0445\u0438\u043c\u0438\u0446\u0438, \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438, \u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0438, \u0443\u0447\u0438\u0442\u0435\u043b\u0438 \u043f\u043e \u043c\u0443\u0437\u0438\u043a\u0430 \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0435.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0418\u0441\u043a\u0430\u043c \u0434\u0430 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0438 \u043d\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435, \u043d\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438 \u043d\u0430 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e. \u0421 \u0440\u0430\u0434\u043e\u0441\u0442 \u043e\u0442\u043a\u0440\u0438\u0432\u0430\u043c, \u0447\u0435 \u0442\u0435 \u0441\u0430 \u043d\u0430\u043c\u0435\u0440\u0438\u043b\u0438 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u043e \u043c\u044f\u0441\u0442\u043e \u0432 \u043d\u0430\u0448\u0435\u0442\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e. \u041d\u043e \u043f\u0440\u0438\u0432\u044a\u0440\u0437\u0430\u043d\u043e\u0441\u0442\u0442\u0430 \u043a\u044a\u043c \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u0442\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f \u0433\u0438 \u043d\u0430\u043a\u0430\u0440\u0430 \u0434\u0430 \u0441\u044a\u0437\u0434\u0430\u0434\u0430\u0442 \u0441\u0432\u043e\u0439 \u043a\u043b\u0443\u0431 \u201e\u041f\u0438\u0442\u0430\u0433\u043e\u0440 \u2013 \u043f\u0440\u0438\u044f\u0442\u0435\u043b\u0438 \u043d\u0430 \u041e\u041c\u0413\u201c, \u0434\u0430 \u0438\u0437\u0433\u0440\u0430\u0434\u044f\u0442 \u0441\u0432\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e, \u0432 \u043a\u043e\u0435\u0442\u043e \u0434\u0430 \u0433\u0438 \u043e\u0431\u0435\u0434\u0438\u043d\u044f\u0432\u0430 \u043f\u0440\u0438\u0437\u043d\u0430\u0442\u0435\u043b\u043d\u043e\u0441\u0442\u0442\u0430 \u043a\u044a\u043c \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f\u0442\u0430 \u0438 \u0433\u043e\u0440\u0434\u043e\u0441\u0442\u0442\u0430, \u0447\u0435 \u0441\u0430 \u043d\u0430\u0448\u0438 \u0432\u044a\u0437\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph --><!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041d\u0430\u043a\u0440\u0430\u044f \u043a\u0430\u043a\u0432\u043e \u0434\u0430 \u043f\u043e\u0436\u0435\u043b\u0430\u044f \u043d\u0430 \u0443\u0447\u0438\u0442\u0435\u043b\u0438, \u0443\u0447\u0435\u043d\u0438\u0446\u0438 \u0438 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438?<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u041d\u0430 \u043c\u043e\u044f\u0442\u0430 \u0432\u044a\u0437\u0440\u0430\u0441\u0442 \u0438\u0437\u0432\u0435\u0436\u0434\u0430\u043c \u043d\u0430 \u043f\u0440\u0435\u0434\u0435\u043d \u043f\u043b\u0430\u043d \u0437\u0434\u0440\u0430\u0432\u0435, \u0437\u0434\u0440\u0430\u0432\u0435 \u0438 \u043f\u0430\u043a \u0437\u0434\u0440\u0430\u0432\u0435.<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>\u0418\u043c\u0430 \u043b\u0438 \u0433\u043e, \u043a\u0430\u0437\u0432\u0430\u0442, \u0438 \u0443\u0441\u043f\u0435\u0445\u0438\u0442\u0435 \u0438\u0434\u0432\u0430\u0442, \u0438\u0434\u0432\u0430 \u0438 \u0449\u0430\u0441\u0442\u0438\u0435\u0442\u043e.\u201c<\/p>\r\n<!-- \/wp:paragraph -->\r\n\r\n<!-- wp:spacer -->\r\n<div class=\"wp-block-spacer\" style=\"height: 100px;\" aria-hidden=\"true\">\u00a0<\/div>\r\n<!-- \/wp:spacer -->\r\n\r\n<!-- wp:quote -->\r\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\r\n<p>\u041b\u042e\u0411\u041e\u0412\u0422\u0410 \u041a\u042a\u041c \u0427\u0418\u0421\u041b\u041e\u0422\u041e \u03c0\u2026 \u0421\u041b\u0415\u0414 40 \u0413\u041e\u0414\u0418\u041d\u0418 &#8211; \u0435\u0434\u043d\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044f, \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0430 \u043e\u0442 XI \u0433 \u043a\u043b\u0430\u0441, \u0432\u0438\u043f\u0443\u0441\u043a 1976 \u0433\u043e\u0434\u0438\u043d\u0430.<\/p>\r\n<!-- \/wp:paragraph --><\/blockquote>\r\n<!-- \/wp:quote -->\r\n\r\n<!-- wp:paragraph -->\r\n<p>&nbsp;<\/p>\r\n<!-- \/wp:paragraph --><\/div>\r\n<!-- \/wp:column -->\r\n\r\n<!-- wp:column {\"width\":\"33.33%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis: 33.33%;\"><!-- wp:image {\"id\":6552,\"width\":270,\"height\":333,\"sizeSlug\":\"full\",\"linkDestinati