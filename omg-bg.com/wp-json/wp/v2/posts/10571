0441. <\/strong><br \/>\n\t\u041d\u0430 <strong>\u043a\u043e\u043d\u043a\u0443\u0440\u0441 \u0437\u0430 \u043c\u043b\u0430\u0434\u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u0438 ,,\u0416\u0443\u0440\u043d\u0430\u043b\u0438\u0441\u0442\u0438\u0442\u0435 \u043d\u0430 \u0431\u044a\u0434\u0435\u0449\u0435\u0442\u043e\u201d, \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0438\u0440\u0430\u043d \u043e\u0442 \u0441\u0434\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u201c\u0420\u043e\u0434\u043e\u043b\u044e\u0431\u0446\u0438 \u0437\u0430 \u041f\u043b\u043e\u0432\u0434\u0438\u0432\u201d \u0441\u044a\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u043c\u0435\u0434\u0438\u044f\u0442\u0430 \u201e\u041a\u0440\u0430\u0441\u0438\u0432 \u041f\u043b\u043e\u0432\u0434\u0438\u0432\u201d, \u0418\u0432\u0435\u043b\u0438\u043d\u0430 \u0441\u043f\u0435\u0447\u0435\u043b\u0438 \u043f\u044a\u0440\u0432\u043e\u0442\u043e \u043c\u044f\u0441\u0442\u043e<\/strong> \u0432\u044a\u0432 \u0432\u044a\u0437\u0440\u0430\u0441\u0442\u043e\u0432\u0430\u0442\u0430 \u0433\u0440\u0443\u043f\u0430 \u0437\u0430 \u0443\u0447\u0435\u043d\u0438\u0446\u0438 \u043e\u0442 IX \u0434\u043e XII \u043a\u043b\u0430\u0441 \u0438\u043b\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0438 \u043a\u044a\u043c \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0432\u0435\u0436\u0434\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0430 (\u0441 \u043d\u0430\u0433\u0440\u0430\u0434\u0435\u043d \u0444\u043e\u043d\u0434 \u0437\u0430 \u043f\u044a\u0440\u0432\u043e \u043c\u044f\u0441\u0442\u043e 1000 \u043b\u0435\u0432\u0430) \u0441\u044a\u0441 \u0441\u0442\u0430\u0442\u0438\u044f, \u043a\u043e\u044f\u0442\u043e \u0435 \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u0430 \u0441 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438\u0442\u0435 \u043d\u0430 \u0433\u0440\u0430\u0434\u0441\u043a\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442. \u041a\u043e\u043d\u043a\u0443\u0440\u0441\u044a\u0442 \u0446\u0435\u043b\u0438 \u0434\u0430 \u0440\u0430\u0437\u043a\u0440\u0438\u0435 \u043c\u043b\u0430\u0434\u0438\u0442\u0435 \u0442\u0430\u043b\u0430\u043d\u0442\u0438 \u043d\u0430 \u041f\u043b\u043e\u0432\u0434\u0438\u0432, \u043a\u043e\u0438\u0442\u043e \u0438\u043c\u0430\u0442 \u0436\u0435\u043b\u0430\u043d\u0438\u0435, \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0438 \u0443\u043c\u0435\u043d\u0438\u044f \u0434\u0430 \u043f\u0438\u0448\u0430\u0442 \u0438 \u0434\u0430 \u0440\u0430\u0437\u043a\u0430\u0437\u0432\u0430\u0442, \u043a\u0430\u043a\u0442\u043e \u0438 \u0434\u0430 \u0440\u0430\u0437\u0441\u043b\u0435\u0434\u0432\u0430\u0442, \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0432\u0430\u0442 \u0438 \u0440\u0430\u0437\u0431\u0435\u0440\u0430\u0442 \u0437\u0430\u043e\u0431\u0438\u043a\u0430\u043b\u044f\u0449\u0430\u0442\u0430 \u043d\u0438 \u0441\u0440\u0435\u0434\u0430, \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f\u0439\u043a\u0438 \u0438\u0434\u0435\u0438 \u0437\u0430 \u043f\u0440\u043e\u043c\u0435\u043d\u0438, \u043a\u043e\u0438\u0442\u043e \u0434\u0430 \u043e\u043a\u0430\u0436\u0430\u0442 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u043d\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0435.<br \/>\n\t<strong>\u0418\u0432\u0435\u043b\u0438\u043d\u0430 \u041f\u0430\u0432\u043b\u043e\u0432\u0430 <\/strong>\u043f\u0440\u0435\u0437 \u043b\u044f\u0442\u043e\u0442\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u0430 \u0438 \u0432 \u043e\u0449\u0435 \u0435\u0434\u0438\u043d <strong>\u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0443\u0447\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0441 \u0437\u0430 \u0435\u0441\u0435 \u0438\u043b\u0438 \u0440\u0430\u0437\u043a\u0430\u0437, \u043f\u043e\u0441\u0432\u0435\u0442\u0435\u043d \u043d\u0430 145 \u0433\u043e\u0434\u0438\u043d\u0438 \u043e\u0442 \u0440\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u043f\u0438\u0441\u0430\u0442\u0435\u043b\u044f \u0419\u043e\u0440\u0434\u0430\u043d \u0419\u043e\u0432\u043a\u043e\u0432, \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0438\u0440\u0430\u043d \u043e\u0442 \u0420\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u0443\u0437\u0435\u0439 \u2013 \u0414\u043e\u0431\u0440\u0438\u0447 \u0438 \u0418\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043c\u0443\u0437\u0435\u0439 \u2013 \u041a\u043e\u0442\u0435\u043b<\/strong>, \u043d\u0430 \u0442\u0435\u043c\u0430 \u201e\u0421 \u043c\u043d\u043e\u0433\u043e \u043d\u0435\u0449\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u043d\u0430\u0434\u0430\u0440\u0438 \u0431\u043e\u0433 \u043d\u044f\u043a\u043e\u0433\u043e, \u043d\u043e \u043d\u044f\u043c\u0430 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c \u0434\u0430\u0440 \u043e\u0442 \u0445\u0443\u0431\u043e\u0441\u0442\u0442\u0430\u201c (\u201e\u041f\u0435\u0441\u0435\u043d\u0442\u0430 \u043d\u0430 \u043a\u043e\u043b\u0435\u043b\u0435\u0442\u0430\u0442\u0430\u201c). \u0421\u044a\u0441 \u0441\u0432\u043e\u0435\u0442\u043e \u0435\u0441\u0435 <strong>\u0418\u0432\u0435\u043b\u0438\u043d\u0430 \u041f\u0430\u0432\u043b\u043e\u0432\u0430 \u0441\u043f\u0435\u0447\u0435\u043b\u0438 \u0442\u0440\u0435\u0442\u043e \u043c\u044f\u0441\u0442\u043e<\/strong> \u0432\u044a\u0432 \u0432\u044a\u0437\u0440\u0430\u0441\u0442\u043e\u0432\u0430 \u0433\u0440\u0443\u043f\u0430 IX \u2013 XII \u043a\u043b\u0430\u0441.<br \/>\n\t\u041f\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u0442\u0430 \u043d\u0430 \u0418\u0432\u0435\u043b\u0438\u043d\u0430 \u0441\u0430 \u0433\u043e\u0440\u0434\u043e\u0441\u0442 \u043d\u0435 \u0441\u0430\u043c\u043e \u0437\u0430 \u0443\u0447\u0438\u0442\u0435\u043b\u044f \u045d \u043f\u043e \u0431\u044a\u043b\u0433\u0430\u0440\u0441\u043a\u0438 \u0435\u0437\u0438\u043a \u0438 \u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0430 &#8211; \u0434-\u0440 \u0428\u0438\u043d\u043a\u0430 \u0414\u0438\u0447\u0435\u0432\u0430-\u0425\u0440\u0438\u0441\u0442\u043e\u0437\u043e\u0432\u0430, \u043d\u043e \u0438 \u0437\u0430 \u041c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430 \u0433\u0438\u043c\u043d\u0430\u0437\u0438\u044f \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201c \u2013 \u0443\u0447\u0438\u043b\u0438\u0449\u0435\u0442\u043e, \u043a\u043e\u0435\u0442\u043e \u043e\u0442\u043a\u0440\u0438\u0432\u0430 \u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430 \u0442\u0430\u043b\u0430\u043d\u0442\u0438\u0442\u0435 \u043d\u0430 \u0441\u0432\u043e\u0438\u0442\u0435 \u0443\u0447\u0435\u043d\u0438\u0446\u0438.<br \/>\n\t<strong>\u041f\u043e\u0436\u0435\u043b\u0430\u0432\u0430\u043c\u0435 \u0437\u0434\u0440\u0430\u0432\u0435 \u0438 \u043e\u0449\u0435 \u043c\u043d\u043e\u0433\u043e \u0443\u0441\u043f\u0435\u0445\u0438 \u043d\u0430 \u0418\u0432\u0435\u043b\u0438\u043d\u0430 \u041f\u0430\u0432\u043b\u043e\u0432\u0430!<\/strong><br \/>\n<em>\u043e\u0442 \u0420\u044a\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e\u0442\u043e<\/em><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u041f\u043e\u0440\u0435\u0434\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0441\u0442\u0432\u043e, \u0447\u0435 \u0443\u0447\u0435\u043d\u0438\u0446\u0438\u0442\u0435 \u0432 \u041c\u0413 \u201e\u0410\u043a\u0430\u0434. \u041a\u0438\u0440\u0438\u043b \u041f\u043e\u043f\u043e\u0432\u201c \u0441\u0430 \u043d\u0435 \u0441\u0430\u043c\u043e \u0434\u043e\u0431\u0440\u0438 \u0432 \u0442\u043e\u0447\u043d\u0438\u0442\u0435 \u043d\u0430\u0443\u043a\u0438, \u043d\u043e \u0438 \u0432\u0434\u044a\u0445\u043d\u043e\u0432\u0435\u043d\u043e \u0437\u0430\u0432\u043e\u044e\u0432\u0430\u0442 \u0432\u044a\u0440\u0445\u043e\u0432\u0435\u0442\u0435 \u043d\u0430 \u0445\u0443\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u0438\u0441\u0442\u0